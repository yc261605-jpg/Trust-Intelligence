# 複製這個檔案並改名為 .env，再依需要修改

# 資料庫（預設放在 data/trust.db；程式更新後啟動時會自動重建）
DATABASE_URL=sqlite:///data/trust.db

# 規則版本（每次分級都會記錄）
RULE_VERSION=R-2026.11

# 技師端與管理平台的共用密碼（MVP 簡化版）
STAFF_PASSWORD=toyota-demo

# 車主登入憑證的簽章金鑰（隨便改成一串亂碼即可）
SECRET_KEY=change-me-demo-secret

# 手機掃 QR 要連得到的網址；留空會自動偵測電腦的區網 IP
# 例：PUBLIC_BASE_URL=http://192.168.1.20:8000
PUBLIC_BASE_URL=

# AI 服務專員：到 Google AI Studio 申請 API Key 貼在這裡
# 留空 = 使用內建的規則式回答（Demo 不會壞）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT=30
